# Copiar a .env (NO subir .env a Git) y pegar la clave real
GEMINI_API_KEY=REEMPLAZAR
# Modelo: gemini-2.5-flash (recomendado) o gemini-2.5-flash-lite (si hay error 429 por cuota)
GEMINI_MODEL=gemini-2.5-flash
# Aprobación humana: middleware (HumanInTheLoopMiddleware de bx-ai) | manual (pregunta s/n dentro de la tool)
HITL_MODO=middleware
