/**
 * CAPA 1 - Chat de soporte en la terminal.
 * Ejecutar desde la raíz del repo:  boxlang src/main.bxs
 * Comandos: /nuevo (nueva conversación), /tickets (ver tickets), salir
 */
datos  = new Datos()
fabrica = new Agente( datos, "cli" )
agente  = fabrica.crear()

println( "==========================================================" )
println( " HELP! Agente de soporte FTTH  |  BoxLang AI + " & datos.proveedor() )
println( " HITL: " & datos.cfg( "HITL_MODO", "middleware" ) & "  |  Comandos: /nuevo  /tickets  salir" )
println( "==========================================================" )
claveNecesaria = uCase( datos.proveedor() ) & "_API_KEY"
if ( !len( datos.cfg( claveNecesaria ) ) ) {
	println( "[ERROR] No se encontró " & claveNecesaria & " en .env (ejecuta desde la raíz del repo)." )
}

while ( true ) {
	println( "" )
	entrada = trim( cliRead( "Cliente> " ) ?: "" )
	if ( !len( entrada ) ) continue;
	if ( listFindNoCase( "salir,exit,quit", entrada ) ) break;

	if ( entrada == "/nuevo" ) {
		fabrica = new Agente( datos, "cli" )
		agente  = fabrica.crear()
		println( "[Nueva conversación]" )
		continue;
	}
	if ( entrada == "/tickets" ) {
		println( jsonSerialize( data = datos.tickets(), pretty = true ) )
		continue;
	}

	try {
		respuesta = agente.run( entrada )
		println( "" )
		println( "Fibra> " & respuesta )
	} catch ( any e ) {
		println( "[ERROR] " & e.message )
		println( "Si es 429/402 (cuota o saldo): revisa la cuenta del proveedor o cambia LLM_PROVIDER en .env" )
	}
}
println( "Fin de la sesión." )
